// The engine's executables (bb-probe, bb-start) as Windows shows them: firewall prompts, Task
// Manager, file properties. The icon is the launcher's.
1 ICON "nightwatch.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Nightwatch Co-op"
      VALUE "ProductName", "Nightwatch Co-op"
      VALUE "CompanyName", "Nightwatch Co-op"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
