#version 450
// bbport's GLSL PsychoV30 (host_shaders/hdr/psychov30.glsl), with every parameter bbport passes
// (glob.h).
#extension GL_GOOGLE_include_directive : require
#include "psychov30.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { vec4 inputs[]; };
layout(std430, binding = 1) writeonly buffer Out { vec4 outputs[]; };
layout(push_constant) uniform P {
    float peak; int mode; int boundary; float compression;
    float exposure, highlights, shadows, contrast, purity, cone, adaptive, background;
    float gamut_compression, pad0, pad1, pad2;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    outputs[i] = vec4(rd_psychov30(inputs[i].xyz, pc.peak, pc.exposure, pc.highlights, pc.shadows,
                                   pc.contrast, pc.purity, pc.cone, vec3(pc.adaptive),
                                   vec3(pc.background), pc.gamut_compression, pc.mode,
                                   pc.compression, pc.boundary), 1.0);
}
