// Bloodborne.exe: the launcher's icon and a description for Windows and Steam.
1 ICON "../BloodborneLauncher/app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Nightwatch Co-op (starts the game with the launcher's settings)"
      VALUE "ProductName", "Nightwatch Co-op"
      VALUE "OriginalFilename", "Bloodborne.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
