<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Eldritch (Launcher › Appearance › Theme): gothic Victorian, with something wrong underneath.
        Warm near-black instead of blue-black, dried blood as the one accent, bone for text, ochre
        for warnings. The art (moon, silhouette, arches, eyes) is Views/EldritchArt.xaml.
        Merged over Glass.xaml by LauncherTheme; solid fills only, no glow and no button gradients.
    -->

    <FontFamily x:Key="UiFont">Constantia, Palatino Linotype, Georgia, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF0E0A09" />
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#18E8DCC8" />
    <SolidColorBrush x:Key="GlassPaneStrokeBrush" Color="#3A8A6A55" />
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#228A6A55" />
    <SolidColorBrush x:Key="PillTrackBrush" Color="#59000000" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF5A1915" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1AE8DCC8" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#12E8DCC8" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#339C7B62" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1FE8DCC8" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2BE8DCC8" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#14E8DCC8" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#59000000" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2E9C7B62" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1F9C7B62" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1AE8DCC8" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#26A0392C" />
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#80060403" />

    <SolidColorBrush x:Key="DialogScrimBrush" Color="#B3050303" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF1A1311" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#FF4A2C24" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8DFCF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFBFB29C" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF948672" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFC4564A" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFC99B43" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFD9604F" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#FF9DB08A" />

</ResourceDictionary>
