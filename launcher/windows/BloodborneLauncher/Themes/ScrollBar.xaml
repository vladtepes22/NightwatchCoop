<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        WPF-UI's vertical scroll bar at twice its size: its 6 px thumb was too thin to grab.
        Same look and hover behaviour (track and arrows fade in, the thumb widens), only bigger.
        This un-keyed style replaces WPF-UI's on purpose; horizontal bars keep its template.
    -->

    <Duration x:Key="NwScrollAnimationDuration">0:0:0.16</Duration>

    <Style x:Key="NwScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFill}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="NwVerticalScrollBar" TargetType="ScrollBar">
        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="20" />
                <RowDefinition Height="0.00001*" />
                <RowDefinition MaxHeight="20" />
            </Grid.RowDefinitions>
            <Border x:Name="PART_Border" Grid.RowSpan="3" Width="18" HorizontalAlignment="Center"
                    Background="{DynamicResource ScrollBarTrackFillPointerOver}" CornerRadius="9" Opacity="0" />
            <RepeatButton x:Name="PART_ButtonScrollUp" Grid.Row="0" Width="18" Height="18" FontSize="14"
                          Command="ScrollBar.LineUpCommand" Content="{x:Static ui:SymbolRegular.CaretUp24}"
                          Opacity="0" Style="{DynamicResource UiScrollBarLineButton}" />
            <Track x:Name="PART_Track" Grid.Row="1" Width="12" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{DynamicResource UiScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource NwScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{DynamicResource UiScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton x:Name="PART_ButtonScrollDown" Grid.Row="2" Width="18" Height="18" FontSize="14"
                          Command="ScrollBar.LineDownCommand" Content="{x:Static ui:SymbolRegular.CaretDown24}"
                          Opacity="0" Style="{DynamicResource UiScrollBarLineButton}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PART_Track" Storyboard.TargetProperty="Width"
                                             To="16" Duration="{StaticResource NwScrollAnimationDuration}" />
                            <DoubleAnimation Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource NwScrollAnimationDuration}" />
                            <DoubleAnimation Storyboard.TargetName="PART_ButtonScrollUp" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource NwScrollAnimationDuration}" />
                            <DoubleAnimation Storyboard.TargetName="PART_ButtonScrollDown" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource NwScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PART_Track" Storyboard.TargetProperty="Width"
                                             To="12" Duration="{StaticResource NwScrollAnimationDuration}" />
                            <DoubleAnimation Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource NwScrollAnimationDuration}" />
                            <DoubleAnimation Storyboard.TargetName="PART_ButtonScrollUp" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource NwScrollAnimationDuration}" />
                            <DoubleAnimation Storyboard.TargetName="PART_ButtonScrollDown" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource NwScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14" />
                <Setter Property="Template" Value="{DynamicResource UiHorizontalScrollBar}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="22" />
                <Setter Property="Template" Value="{StaticResource NwVerticalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
