<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Bloodborne Launcher</AssemblyName>
    <RootNamespace>BloodborneLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.9</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The source fingerprint the builder writes beside the exe; shared so both agree on it. -->
    <Compile Include="..\Shared\SourceStamp.cs" Link="Core\SourceStamp.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\backdrop.jpg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SeamlessTests" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
