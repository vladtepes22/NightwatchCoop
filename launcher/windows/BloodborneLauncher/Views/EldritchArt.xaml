<UserControl x:Class="BloodborneLauncher.Views.EldritchArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True">
    <!--
        The Eldritch theme behind the glass panes: painted layers (Themes/Eldritch/*) that the code moves.
        Back to front: the city, the moon, the fog (the surprises play on MainWindow's ArtStage, in front).
        Placement and motion are in EldritchArt.xaml.cs; nothing here takes clicks.
    -->
    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <!-- A wash over the city, darker towards the bottom where the settings are read. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#590E0A09" Offset="0" />
                    <GradientStop Color="#8C0E0A09" Offset="0.45" />
                    <GradientStop Color="#C00E0A09" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Canvas x:Name="Sky" />
        <Grid x:Name="FogBand" VerticalAlignment="Bottom">
            <Rectangle x:Name="FogBack" Opacity="0.4" Height="512" VerticalAlignment="Bottom" />
            <Rectangle x:Name="FogFront" Opacity="0.5" Height="384" VerticalAlignment="Bottom" Margin="0,0,0,-40" />
        </Grid>
        <Canvas x:Name="Surprises" />
    </Grid>
</UserControl>
